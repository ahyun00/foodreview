<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE mapper
    PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
    
<mapper namespace= "org.foodreview.place.PlaceMapper">
	
	<!-- 가게 목록 조회 + 이름 검색  + 카테고리 필터 + 페이징 -->
	<select id="getPlaceList" resultType= "org.foodreview.place.Place">
		
		select * from place	
		
		<where>
			<!-- 이름 검색 -->
			<if test="keyword != null and keyword != ''">
				AND name LIKE CONCAT('%', #{keyword}, '%')
			</if>
			
			<!-- 카테고리 필터 -->
			<if test="category != null and category !=''">
				AND category = #{category}
			</if>
		</where>
		
		order by pno desc
		LIMIT #{size} OFFSET #{offset}
	</select>	
		
	
	<!-- 가게 상세 조회 -->
	<select id="getPlace" resultType= "org.foodreview.place.Place">
		select * from place
		where pno = #{pno}
	</select>
	
	
	<!-- 검색 및 카테고리 조건에 맞는 전체 맛집 개수 조회 -->
	<select id= "countPlaces" resultType= "int">
	
		select count(*) from place
		
		<where>
			<!-- 이름 검색 조건 -->
			<if test= "keyword != null and keyword != ''">
				AND name LIKE CONCAT('%', #{keyword}, '%')
			</if>
			
			<!-- 카테고리 필터 조건 -->
			<if test= "category != null and category != ''">
				AND category = #{category}
			</if>
		</where>
		
	</select>
	
	
	












</mapper>